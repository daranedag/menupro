# Server-only: pooled app connection and direct migration connection.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
# At least 32 random characters. Never expose it with NEXT_PUBLIC_.
NEON_AUTH_COOKIE_SECRET=
APP_URL=http://localhost:3000

# Disabled until Mercado Pago test credentials and webhooks have been verified.
MENUPRO_BILLING_MODE=disabled
MERCADOPAGO_APPLICATION_ID=3623413345304006
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Random server-only secret, paired with its SHA-256 hash in menupro_system_keys.
# It grants access only to the explicitly scoped MenuPro operation RPCs.
MENUPRO_WORKER_SECRET=
MENUPRO_EMAIL_ENABLED=false
# Transactional email. Keep the API key private and use a verified Resend sender.
RESEND_API_KEY=
RESEND_FROM=
RESEND_REPLY_TO=
# Optional recipient override for the daily operations digest.
RESEND_ADMIN_EMAIL=

# 32 random bytes as 64 hexadecimal characters. Server-only; retain for decryption.
MENUPRO_IMAGE_ENCRYPTION_KEY=
